# ============================================================
# CPG Analytics Copilot - Environment Configuration
# ============================================================
#
# Copy this file to:
#
# backend/.env
#
# Then replace placeholder values with your local configuration.
#
# IMPORTANT:
# Never commit backend/.env or any file containing real secrets.
# ============================================================


# ------------------------------------------------------------
# Groq
# ------------------------------------------------------------

# Required.
# Your Groq API key.
GROQ_API_KEY=your_groq_api_key_here

# Groq model used by the analytics agent.
GROQ_MODEL=openai/gpt-oss-20b


# ------------------------------------------------------------
# Agent Runtime
# ------------------------------------------------------------

# Maximum number of tool-calling iterations allowed
# during a single agent run.
#
# Valid range: 1-20
MAX_TOOL_ITERATIONS=8


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

# Comma-separated list of frontend origins allowed
# to call the FastAPI backend.
#
# Local Vite development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ------------------------------------------------------------
# Application Metadata
# ------------------------------------------------------------

APP_NAME=CPG Analytics Copilot

APP_VERSION=0.1.0