# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- Auth ---
AUTH_MODE=local            # local | oidc
JWT_SECRET=change-me
DEMO_PASSWORD=demo123
# OIDC (Entra ID / Okta / Auth0) when AUTH_MODE=oidc
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_ISSUER=
OIDC_ROLE_MAP=Analytics.Admin=admin,Analytics.Manager=manager,Analytics.Analyst=analyst

# --- Data ---
# Default is the bundled synthetic SQLite. For Azure SQL:
# ANALYTICS_DB_URL=mssql+pyodbc://user:pass@server.database.windows.net/db?driver=ODBC+Driver+18+for+SQL+Server
ANALYTICS_DB_URL=
CURRENCY_SYMBOL=$

# --- Integrations ---
WORKFLOW_WEBHOOK_URL=
BI_DASHBOARD_URL=https://app.powerbi.com/groups/me/reports/REPORT_ID
CORS_ORIGINS=http://localhost:5173
RADAR_INTERVAL_MIN=0       # >0 enables background Business Issue Radar scans
